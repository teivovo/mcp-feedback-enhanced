# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Router Configuration
ROUTER_PORT=8080

# Session Management
SESSION_CLEANUP_INTERVAL=300000    # 5 minutes in milliseconds
SESSION_MAX_AGE=1800000            # 30 minutes in milliseconds

# Auto-shutdown Configuration
IDLE_SHUTDOWN_TIMEOUT=600000       # 10 minutes in milliseconds (router shuts down after this idle time)
IDLE_CHECK_INTERVAL=300000         # 5 minutes in milliseconds (how often to check for idle state)
